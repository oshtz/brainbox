{
  "name": "brainbox",
  "private": true,
  "version": "1.1.8",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:tauri:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-tauri-native.ps1",
    "test:all": "pnpm run test:run && pnpm run test:e2e",
    "smoke:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-tauri.ps1",
    "verify": "pnpm run build && pnpm run test:run && pnpm run test:e2e"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-spring/web": "^9.7.5",
    "@tauri-apps/plugin-opener": "2.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/cli": "2.8.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "jsdom": "^26.0.0",
    "playwright": "^1.61.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "flatted@<3.4.2": "3.4.2",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.16",
      "rollup@>=4.0.0 <4.59.0": "4.62.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
