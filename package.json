{
  "name": "brainbox",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:tauri:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-tauri-native.ps1",
    "test:all": "pnpm run test:run && pnpm run test:e2e",
    "smoke:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-tauri.ps1",
    "verify": "pnpm run build && pnpm run test:run && pnpm run test:e2e"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-spring/web": "^9.7.5",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@insco/enigma-virtualbox": "1.3.4",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
